{
	admin localhost:2019
	auto_https disable_certs
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 15s
			write 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

(proxy) {
	request_body {
		max_size 32KB
	}

	reverse_proxy {args[0]} {
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}

www.{$PROD_DOMAIN} {
	import origin_tls
	redir https://{$PROD_DOMAIN}{uri} permanent
}

{$PROD_DOMAIN} {
	import origin_tls
	import proxy 127.0.0.1:3000
}

{$DEV_DOMAIN} {
	import origin_tls
	header X-Robots-Tag "noindex, nofollow"
	import proxy 127.0.0.1:3001
}
